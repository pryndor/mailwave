{
  "name": "mailwave",
  "version": "1.1.0",
  "description": "Local bulk email newsletter tool",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "dev:renderer": "cd renderer && npm run dev -- --port 5173 --strictPort",
    "dev:electron": "electron .",
    "build:renderer": "cd renderer && npm run build",
    "build:linux": "npm run build:renderer && electron-builder --linux",
    "build:win": "npm run build:renderer && electron-builder --win",
    "build:mac": "npm run build:renderer && electron-builder --mac",
    "build:app": "npm run build:linux",
    "build": "npm run build:app",
    "start": "electron ."
  },
  "keywords": [],
  "author": { "name": "Bak.dev", "email": "admin@drugvigil.com" },
  "homepage": "https://drugvigil.com",
  "license": "AGPL-3.0-only",
  "type": "commonjs",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "wait-on": "^9.0.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "basic-ftp": "^5.2.2",
    "better-sqlite3": "^12.9.0",
    "nodemailer": "^8.0.5",
    "papaparse": "^5.5.3",
    "ssh2-sftp-client": "^12.1.1"
  },
  "build": {
    "appId": "dev.bak.mailwave",
    "productName": "MailWave",
    "copyright": "Bak.dev",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist-app",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "renderer/dist/**/*",
      "build/**/*",
      "node_modules/**/*",
      "!node_modules/.cache/**/*",
      "!renderer/src/**/*",
      "!renderer/node_modules/**/*"
    ],
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] }
      ],
      "category": "Office",
      "description": "Local bulk email newsletter tool",
      "desktop": {
        "entry": {
          "Comment": "Bulk email newsletter manager",
          "Categories": "Office;Email;Network;"
        }
      }
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "category": "public.app-category.business"
    },
    "npmRebuild": true
  }
}
