# /var/www/webhook.drugvigil.com/.env on the server (systemd EnvironmentFile).
# Never commit a real .env file. Format is KEY=VALUE, one per line -- no
# multi-line values, which is why the private key is referenced by path here
# instead of pasted inline.

RAZORPAY_WEBHOOK_SECRET=
LICENSE_PRIVATE_KEY_PATH=/var/www/webhook.drugvigil.com/private_key.pem
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
PORT=8787
